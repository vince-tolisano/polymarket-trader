# Copy to .env and fill in. .env is git- and docker-ignored so the key never
# leaves your machine. Used by docker-compose.yml.

# Polygon wallet private key (0x-prefixed). Required for LIVE trading; not
# needed for --dry-run. NEVER commit the real value.
POLY_PRIVATE_KEY=0x...

# Timezone for the CSV period_of_day column + default filename stamp.
# Defaults to UTC if unset.
TZ=America/New_York
